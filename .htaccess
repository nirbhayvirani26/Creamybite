# ============================================================
#  Creamy Bite – access rules
# ============================================================

# secrets.php holds the Stripe keys, database password and Gmail app
# password. PHP normally executes rather than serves it, but if PHP is
# ever misconfigured or disabled the raw file would be readable — so
# block it at the webserver too.
<FilesMatch "^secrets\.php$">
    Require all denied
</FilesMatch>

# .sql migration files are served as plain text by default.
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>

# Never list a directory that has no index file.
Options -Indexes

# ── Clean URLs ───────────────────────────────────────────────
#  Public pages are addressed WITHOUT an extension and without the folder
#  they happen to live in:
#
#      /order          serves   pages/order.php
#      /trade_register serves   pages/trade_register.php
#      /               serves   index.php
#
#  Three rules below, in the order they must run:
#
#    1. /pages/order.php  -> 301 -> /order      (the current address)
#    2. /order.php        -> 301 -> /order      (the original flat address,
#                                                still bookmarked and indexed)
#    3. /order            -> internally serves pages/order.php
#
#  The two redirects are 301 rather than 302 because they are permanent, and
#  only a permanent redirect passes on the ranking an address has earned. They
#  run BEFORE the rewrite so that every old URL converges on one canonical
#  address instead of two addresses serving identical pages.
#
#  Rule 3 is an INTERNAL rewrite — the address bar keeps saying /order. That is
#  the whole point, and it is also what used to make this impossible: pages
#  linked their assets as "../assets/...", which resolves against the address,
#  so serving pages/order.php at /order left every stylesheet pointing at
#  /../assets and the page came out unstyled. includes/asset.php now resolves
#  asset URLs from the site root and cbUrl() builds internal links the same
#  way, which is what lets the address and the file location differ at all.
#
#  Rules 2 and 3 only fire when the request is not a real file or directory, so
#  index.php, the AJAX handlers and everything under assets/ and admin/ are
#  untouched — and the pattern allows no slash, so nothing under admin/ or
#  pages/ can be caught by them either. Rule 2 additionally checks that the
#  page really exists before redirecting, so a request for a .php that never
#  existed 404s where it stands instead of being sent to a clean URL with
#  nothing behind it. An unknown clean address (/nonsense) rewrites onto
#  pages/nonsense.php, which is not there, and Apache 404s as it should.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── CANONICAL HOST ───────────────────────────────────────
    #  creamybite.com, www.creamybite.com and orders.creamybite.com all served
    #  the site, so a search engine saw three identical copies and had to guess
    #  which was real — splitting the ranking between them and, until the new
    #  config went up, pointing every canonical tag at the subdomain.
    #
    #  One host wins and the other two send visitors to it. 301 rather than 302:
    #  this is permanent, and only a permanent redirect passes on the ranking
    #  the old address has already earned.
    #
    #  It cannot fight the host's own http->https redirect: the first condition
    #  excludes creamybite.com itself, so a request already on the canonical
    #  host is left alone whichever scheme it arrived on, and there is nothing
    #  for the two redirects to bounce between. (The comment here used to claim
    #  a "%{HTTPS} on" condition was doing that job. There isn't one, and there
    #  does not need to be — but a note describing a line that is not in the
    #  file is worse than no note, because the next person adds it back.)
    RewriteCond %{HTTP_HOST} !^creamybite\.com$ [NC]
    RewriteCond %{HTTP_HOST} creamybite\.com$ [NC]
    RewriteRule ^(.*)$ https://creamybite.com/$1 [R=301,L]

    # THE REDIRECT_STATUS GUARD ON RULES 1 AND 2 IS LOAD-BEARING.
    #
    # Rule 3 rewrites /order onto pages/order.php internally, and an internal
    # rewrite in .htaccess re-enters these rules with REQUEST_URI now reading
    # /pages/order.php. Rule 1 then recognises its own handiwork as an old-style
    # address and 301s it back to /order, which rewrites again — every page on
    # the site answering a redirect loop, and the browser giving up with
    # ERR_TOO_MANY_REDIRECTS.
    #
    # REDIRECT_STATUS is empty only on a request that arrived from outside and
    # is set once Apache has redirected internally, so testing it for empty
    # means "this is the address the visitor actually asked for". Rule 3 needs
    # no such guard: it cannot match /pages/... because its pattern allows no
    # slash.

    # 1. The folder address is no longer canonical: /pages/order.php -> /order
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_URI} ^(.*/)pages/([A-Za-z0-9_-]+)\.php$
    RewriteRule ^(.*)$ %1%2 [R=301,L]

    # 2. The original flat address: /order.php -> /order
    #    Fires only when nothing real matches, so index.php and the handlers at
    #    the root keep their .php and are never redirected.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.*/)[^/]+\.php$
    RewriteCond %{DOCUMENT_ROOT}%1pages/$1.php -f
    RewriteRule ^([A-Za-z0-9_-]+)\.php$ %1$1 [R=301,L]

    # 3. Serve the clean address from the file, without changing the address.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([A-Za-z0-9_-]+)/?$ pages/$1.php [L]
</IfModule>

# ── Secrets must never be served ─────────────────────────────
# A .env served as plain text hands over the Stripe keys, the mail password
# and the database login to anyone who guesses the URL. Apache would happily
# serve it: it has no handler and no extension it recognises as code.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# ── Response headers every page should carry ─────────────────
#
# Three headers, none of which change how the site behaves for a customer.
#
# Referrer-Policy is the one that matters most here. Several pages load things
# from other companies — the icon font from cdnjs, the map on the About page,
# Stripe on the checkout — and by default the browser tells each of them the
# full address of the page that asked. That leaks the admin URLs an owner was
# on, and any one-time token sitting in an address, to companies with no
# business knowing them. strict-origin-when-cross-origin sends them the domain
# and nothing more, while links inside the site still behave normally.
#
# X-Content-Type-Options stops a browser second-guessing a file's type — an
# upload that sniffs as script is the reason the uploads folders have their own
# .htaccess.
#
# X-Frame-Options SAMEORIGIN stops another site putting the admin panel in a
# hidden frame over their own page and collecting the clicks. Same-origin is
# deliberately still allowed: the print station loads receipt.php into a hidden
# iframe to print it, and that must keep working. The map on the About page is
# unaffected — that is this site embedding someone else, not the reverse.
#
# Deliberately NOT here: Strict-Transport-Security. It tells every browser to
# refuse plain http for this domain for months, which is right for a shop
# taking card payments but is very hard to undo if the certificate ever lapses.
# That is the owner's call, not a default.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Caching ──────────────────────────────────────────────────
#  Stylesheets and scripts are requested with a ?v=<file mtime> on the end
#  (see includes/asset.php), so the URL itself changes the moment a file is
#  edited and re-uploaded. A browser therefore cannot be holding a stale copy
#  under the same URL, which is what made every upload need several hard
#  refreshes before the new design appeared.
#
#  Because the URL carries the version, these can be cached hard: a returning
#  customer re-uses the files instead of re-downloading them, and still sees an
#  update the instant it goes live.
#
#  Images are cached for a day rather than a year. They are NOT versioned, so a
#  logo replaced under the same filename has to be able to come through without
#  waiting a year for the cache to lapse.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 day"
    ExpiresByType image/jpeg                "access plus 1 day"
    ExpiresByType image/webp                "access plus 1 day"
    ExpiresByType image/svg+xml             "access plus 1 day"
    ExpiresByType image/x-icon              "access plus 1 week"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

#  Same rule again through mod_headers, for servers where mod_expires is not
#  enabled — MAMP here does not have it, and shared hosting is inconsistent.
#  Whichever module is present sets the header; if both are, they agree.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

#  The pages themselves must never be cached — an order list or a basket that
#  came out of a cache would show yesterday's data.
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
