# ============================================================
#  Creamy Bite – access rules
# ============================================================

# secrets.php holds the Stripe keys, database password and Gmail app
# password. PHP normally executes rather than serves it, but if PHP is
# ever misconfigured or disabled the raw file would be readable — so
# block it at the webserver too.
<FilesMatch "^secrets\.php$">
    Require all denied
</FilesMatch>

# .sql migration files are served as plain text by default.
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>

# Never list a directory that has no index file.
Options -Indexes

# ── Old flat URLs -> pages/ ──────────────────────────────────
#  The public pages used to sit at the web root (/order.php,
#  /checkout.php, …) and those URLs are already live, bookmarked and
#  indexed. They now live in pages/, so redirect rather than 404.
#
#  301 (not an internal rewrite) on purpose: the browser ends up on the
#  real /pages/... URL, so the "../assets/..." links inside each page
#  resolve correctly. An internal rewrite would keep the old URL in the
#  address bar and every relative asset path would break.
#
#  Only fires when the request does not match a real file or directory,
#  so index.php and the handlers at the root are untouched. The pattern
#  has no slash in it, so an already-rewritten /pages/x.php cannot loop.
#  The target is built from REQUEST_URI rather than written as a bare
#  "pages/$1" so it stays a URL path. A bare relative target makes Apache
#  resolve it against the filesystem and emit the server's absolute disk
#  path in the Location header. Deriving the prefix (%1) also keeps this
#  working whether the site is served from /orders/ or from the domain root.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── CANONICAL HOST ───────────────────────────────────────
    #  creamybite.com, www.creamybite.com and orders.creamybite.com all served
    #  the site, so a search engine saw three identical copies and had to guess
    #  which was real — splitting the ranking between them and, until the new
    #  config went up, pointing every canonical tag at the subdomain.
    #
    #  One host wins and the other two send visitors to it. 301 rather than 302:
    #  this is permanent, and only a permanent redirect passes on the ranking
    #  the old address has already earned.
    #
    #  HTTPS only in the condition, so this cannot fight the host's own
    #  http->https redirect and bounce a visitor between the two.
    RewriteCond %{HTTP_HOST} !^creamybite\.com$ [NC]
    RewriteCond %{HTTP_HOST} creamybite\.com$ [NC]
    RewriteRule ^(.*)$ https://creamybite.com/$1 [R=301,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^(.*/)[^/]+\.php$
    RewriteRule ^([A-Za-z0-9_-]+\.php)$ %1pages/$1 [R=301,L]
</IfModule>

# ── Secrets must never be served ─────────────────────────────
# A .env served as plain text hands over the Stripe keys, the mail password
# and the database login to anyone who guesses the URL. Apache would happily
# serve it: it has no handler and no extension it recognises as code.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# ── Caching ──────────────────────────────────────────────────
#  Stylesheets and scripts are requested with a ?v=<file mtime> on the end
#  (see includes/asset.php), so the URL itself changes the moment a file is
#  edited and re-uploaded. A browser therefore cannot be holding a stale copy
#  under the same URL, which is what made every upload need several hard
#  refreshes before the new design appeared.
#
#  Because the URL carries the version, these can be cached hard: a returning
#  customer re-uses the files instead of re-downloading them, and still sees an
#  update the instant it goes live.
#
#  Images are cached for a day rather than a year. They are NOT versioned, so a
#  logo replaced under the same filename has to be able to come through without
#  waiting a year for the cache to lapse.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 day"
    ExpiresByType image/jpeg                "access plus 1 day"
    ExpiresByType image/webp                "access plus 1 day"
    ExpiresByType image/svg+xml             "access plus 1 day"
    ExpiresByType image/x-icon              "access plus 1 week"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

#  Same rule again through mod_headers, for servers where mod_expires is not
#  enabled — MAMP here does not have it, and shared hosting is inconsistent.
#  Whichever module is present sets the header; if both are, they agree.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|svg)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

#  The pages themselves must never be cached — an order list or a basket that
#  came out of a cache would show yesterday's data.
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
