# ============================================================
#  Creamy Bite — secrets
#
#  This file is NOT in git and NOT in the upload zip. That is deliberate:
#  every deploy used to overwrite includes/secrets.php with the developer
#  copy, so a Stripe key rolled on the live server was replaced by an old
#  one on the next upload — which is why "Could not load payment form"
#  appeared after every deployment.
#
#  Keep one .env on your Mac and one on the server. They can differ.
#  Nothing that ships can overwrite either of them.
#
#  After editing on the live server, restart PHP in hPanel.
# ============================================================

# ── Admin panel ──────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Stripe ───────────────────────────────────────────────────
#  Roll keys at https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=gbp

# ── Outgoing email (Gmail SMTP) ──────────────────────────────
#  SMTP_PASS is a Gmail App Password, not the account password.
#  https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# ── Live database (hPanel > Databases) ───────────────────────
DB_LIVE_NAME=
DB_LIVE_USER=
DB_LIVE_PASS=
